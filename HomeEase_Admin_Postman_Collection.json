            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/notifications/instant",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "notifications", "instant"]
            },
            "description": "Dispatches an instant FCM notification. If recipientUserId is null, it broadcasts to all."
