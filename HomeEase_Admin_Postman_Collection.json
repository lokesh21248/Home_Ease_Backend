    {
      "name": "10. Notifications Dispatch & Queue",
      "item": [
        {
          "name": "Send Instant Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientUserId\": \"{{targetUserId}}\",\n  \"title\": \"Admin Announcement\",\n  \"body\": \"Your service partner has been assigned to your order!\"\n}"
