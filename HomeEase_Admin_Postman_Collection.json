{
  "info": {
    "_postman_id": "homeease-admin-api-collection",
    "name": "HomeEase Admin APIs",
    "description": "Complete Postman collection for all 33 Admin Endpoints of HomeEase On-Demand Service Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminUserId",
      "value": "00000000-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "serviceId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "subServiceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "workerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "00000000-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "bannerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "couponId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
