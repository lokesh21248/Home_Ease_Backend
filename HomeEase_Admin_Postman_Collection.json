  "item": [
    {
      "name": "0. Admin Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@homeease.com\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "auth", "login"]
            },
            "description": "Authenticates the seeded administrator and returns the admin profile and access token."
          }
        }
      ]
    },
    {
      "name": "1. Dashboard & Analytics",
      "item": [
        {
          "name": "Get Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "dashboard", "stats"]
            },
            "description": "Fetches aggregated platform KPIs: total revenue, active bookings, registered workers, and customers."
          }
        }
      ]
    },
    {
      "name": "2. User & Customer Management",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users"]
            },
            "description": "Fetches all registered users across the platform."
          }
        },
        {
          "name": "Get Users by Role (CUSTOMER / WORKER / ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users?role=CUSTOMER",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users"],
              "query": [
                {
                  "key": "role",
                  "value": "CUSTOMER",
                  "description": "Filter by CUSTOMER, WORKER, or ADMIN"
                }
              ]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users", "{{targetUserId}}"]
            }
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"WORKER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users", "{{targetUserId}}", "role"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Worker Partner Governance",
      "item": [
        {
          "name": "Get All Workers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/workers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "workers"]
            }
          }
        },
        {
          "name": "Get Worker by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/workers/{{workerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "workers", "{{workerId}}"]
            }
          }
        },
        {
          "name": "Verify Worker Partner KYC",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/workers/{{workerId}}/verify-kyc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "workers", "{{workerId}}", "verify-kyc"]
            },
            "description": "Approves worker KYC documents (Aadhaar & PAN), enabling them to receive dispatch requests."
          }
        },
        {
          "name": "Block Worker Partner (Penalize)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/workers/{{workerId}}/block?hours=24",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "workers", "{{workerId}}", "block"],
              "query": [
                {
                  "key": "hours",
                  "value": "24",
                  "description": "Duration in hours to block the worker"
                }
              ]
            }
          }
        },
        {
          "name": "Unblock Worker Partner",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/workers/{{workerId}}/unblock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "workers", "{{workerId}}", "unblock"]
            }
          }
        }
      ]
    },
