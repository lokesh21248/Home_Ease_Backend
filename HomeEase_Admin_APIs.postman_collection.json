          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/workers/{{workerId}}/block?hours=48",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "workers", "{{workerId}}", "block"],
              "query": [
                {
                  "key": "hours",
                  "value": "48"
                }
              ]
