{
  "info": {
    "_postman_id": "homeease-backend-collection",
    "name": "HomeEase Backend APIs (No JWT)",
    "description": "Collection for testing HomeEase On-Demand Service APIs locally with MySQL and no JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Sharma\",\n  \"phoneNumber\": \"+919876543210\",\n  \"email\": \"rahul.sharma@example.com\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/users/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "users", "register"]}
          }
        },
        {
          "name": "Register Worker",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Amit Electrician\",\n  \"phoneNumber\": \"+919811122233\",\n  \"email\": \"amit.worker@example.com\",\n  \"role\": \"WORKER\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/users/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "users", "register"]}
          }
        },
