    {
      "name": "3. Worker Operations",
      "item": [
        {
          "name": "Register Worker KYC",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-User-Id", "value": "{{worker_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Flat 102, Shanti Nagar, Bengaluru\",\n  \"panNumber\": \"ABCDE1234F\",\n  \"panDocUrl\": \"https://storage.googleapis.com/docs/pan_sample.jpg\",\n  \"aadhaarDocUrl\": \"https://storage.googleapis.com/docs/aadhaar_sample.jpg\",\n  \"bankAccountNo\": \"98765432101234\",\n  \"bankIfsc\": \"HDFC0001234\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/workers/register-kyc", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "workers", "register-kyc"]}
          }
        },
        {
          "name": "Toggle Online Status",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-User-Id", "value": "{{worker_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isOnline\": true\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/workers/status", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "workers", "status"]}
          }
        },
        {
          "name": "Update Live GPS Location",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-User-Id", "value": "{{worker_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 12.971598,\n  \"lng\": 77.594566\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/workers/location", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "workers", "location"]}
          }
        },
        {
          "name": "Get Worker Earnings",
          "request": {
            "method": "GET",
            "header": [{"key": "X-User-Id", "value": "{{worker_id}}"}],
            "url": {"raw": "http://localhost:8080/api/v1/workers/earnings", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "workers", "earnings"]}
          }
        }
