    {
      "name": "4. Customer Bookings & Lifecycle",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-User-Id", "value": "{{customer_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{service_id}}\",\n  \"subServiceIds\": [\"{{sub_service_id}}\"],\n  \"customerLat\": 12.9716,\n  \"customerLng\": 77.5946,\n  \"address\": \"Flat 204, Rosewood Residency, Indiranagar, Bengaluru\",\n  \"couponCode\": \"WELCOME50\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/bookings", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "bookings"]}
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{"key": "X-User-Id", "value": "{{customer_id}}"}],
            "url": {"raw": "http://localhost:8080/api/v1/bookings/my-bookings", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "bookings", "my-bookings"]}
          }
        },
        {
          "name": "Get Booking By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/v1/bookings/{{booking_id}}", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "bookings", "{{booking_id}}"]}
          }
        },
        {
          "name": "Worker Accept Booking",
          "request": {
            "method": "POST",
            "header": [{"key": "X-User-Id", "value": "{{worker_id}}"}],
            "url": {"raw": "http://localhost:8080/api/v1/workers/bookings/{{booking_id}}/accept", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "workers", "bookings", "{{booking_id}}", "accept"]}
          }
        },
        {
          "name": "Worker Verify PIN (Start Job)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-User-Id", "value": "{{worker_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pinCode\": \"1234\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/workers/bookings/{{booking_id}}/verify-pin", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "workers", "bookings", "{{booking_id}}", "verify-pin"]}
          }
        },
        {
          "name": "Add Extra Sub-Service",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-User-Id", "value": "{{worker_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subServiceId\": \"{{extra_sub_service_id}}\",\n  \"quantity\": 1\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/workers/bookings/{{booking_id}}/add-sub-service", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "workers", "bookings", "{{booking_id}}", "add-sub-service"]}
          }
        },
        {
          "name": "Complete Job",
          "request": {
            "method": "POST",
            "header": [{"key": "X-User-Id", "value": "{{worker_id}}"}],
            "url": {"raw": "http://localhost:8080/api/v1/workers/bookings/{{booking_id}}/complete", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "workers", "bookings", "{{booking_id}}", "complete"]}
          }
        }
      ]
    },
    {
      "name": "5. Billing & Webhook",
      "item": [
        {
          "name": "Calculate Billing",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseAmount\": 500.00,\n  \"extraAmount\": 150.00,\n  \"discount\": 50.00\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/billing/calculate", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "billing", "calculate"]}
