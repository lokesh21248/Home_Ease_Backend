            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/auth/otp/send", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "auth", "otp", "send"]}
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\",\n  \"otpCode\": \"123456\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/auth/otp/verify", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "auth", "otp", "verify"]}
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@homeease.com\",\n  \"password\": \"admin\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/admin/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "admin", "auth", "login"]}
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "X-User-Id", "value": "{{user_id}}"}],
            "url": {"raw": "http://localhost:8080/api/v1/users/me", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "users", "me"]}
          }
        }
      ]
    },
    {
