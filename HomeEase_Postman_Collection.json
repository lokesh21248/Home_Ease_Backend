          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/v1/services/{{service_id}}", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "services", "{{service_id}}"]}
          }
        },
        {
          "name": "Get Sub-Services By Service ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/v1/services/{{service_id}}/sub-services", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "services", "{{service_id}}", "sub-services"]}
          }
        },
