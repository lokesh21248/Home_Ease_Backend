            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"paymentId\": \"pay_test_001\",\n  \"orderId\": \"order_test_001\",\n  \"amount\": 60000,\n  \"currency\": \"INR\",\n  \"status\": \"SUCCESS\"\n}"
            },
            "url": {"raw": "http://localhost:8080/api/v1/payments/webhooks", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "payments", "webhooks"]}
          }
        }
      ]
    },
