# /etc/homeease/backend.env   (owner root:root, mode 0600; NEVER commit a filled-in copy)
# Loaded by systemd EnvironmentFile=. No quotes around values; one KEY=value per line.

# --- Redis (identical REDIS_URL on backend, dispatch and tracking) ----------------
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<host>.upstash.io:6379
REDIS_CONNECT_TIMEOUT=5000ms
REDIS_COMMAND_TIMEOUT=2000ms

# --- Required secrets: startup is refused if any is missing, too short, or a known-leaked value ---
DB_USER=<supabase pooler user>
DB_PASS=<new supabase database password>
JWT_SECRET=<openssl rand -hex 32  (>= 32 chars; MUST be identical on backend and tracking)>

# --- Database location (not secret) ---
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# --- Other integrations (set what you use) ---
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
FIREBASE_CREDENTIALS_PATH=/etc/homeease/firebase-service-account.json
KAFKA_BOOTSTRAP_SERVERS=
AUTO_VERIFY_WORKERS=false

# --- Worker presence / heartbeat policy (defaults shown; see HOME_EASE_WORKER_HEARTBEAT_AUDIT.md) ---
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TTL_SECONDS=60
WORKER_PRESENCE_ENFORCE=false
WORKER_PRESENCE_SWEEP_SECONDS=900
WORKER_PRESENCE_SWEEP_ZONES=false

# --- Optional behaviour switches (defaults shown) ---
# One in-flight instant job per worker at accept time (HTTP 409 WORKER_BUSY). false = previous behaviour.
WORKER_ACCEPT_GUARD_ENABLED=false
# Cuts Redis commands per heartbeat for workers who have not moved (see HOME_EASE_REDIS_CAPACITY_ESTIMATE.md).
# OFF by default; enable only after approval.
WORKER_PING_STATIONARY_ENABLED=false
WORKER_PING_STATIONARY_METERS=25
WORKER_PING_STATIONARY_FULL_REFRESH_SECONDS=120

# --- Public nearby-workers preview protection (defaults shown; 0 disables each) ---
NEARBY_WORKERS_RATE_PER_CLIENT=60
NEARBY_WORKERS_RATE_GLOBAL=1200
NEARBY_WORKERS_CACHE_SECONDS=10
