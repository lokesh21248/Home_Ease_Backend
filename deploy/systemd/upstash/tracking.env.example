# /etc/homeease/tracking.env   (owner root:root, mode 0600; NEVER commit a filled-in copy)
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<host>.upstash.io:6379
REDIS_CONNECT_TIMEOUT=5000ms
REDIS_COMMAND_TIMEOUT=2000ms
# Required: startup is refused if missing/short/known-leaked. MUST be identical to the backend's JWT_SECRET.
JWT_SECRET=<same value as backend.env>
GOOGLE_MAPS_API_KEY=
WORKER_PRESENCE_ENFORCE=false
# Optional tuning
# TRACKING_RATE_LIMIT_MAX=30
# TRACKING_MAX_ACCURACY_METERS=50.0
