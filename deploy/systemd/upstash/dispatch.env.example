# /etc/homeease/dispatch.env   (owner root:root, mode 0600; NEVER commit a filled-in copy)
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<host>.upstash.io:6379
REDIS_CONNECT_TIMEOUT=5000ms
REDIS_COMMAND_TIMEOUT=2000ms
# Must equal the backend's value (it only tests that worker:heartbeat:<id> exists; the TTL is set by the backend)
WORKER_PRESENCE_ENFORCE=false
