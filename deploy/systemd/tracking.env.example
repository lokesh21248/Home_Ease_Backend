# ==============================================================================
# HOME EASE – Sensitive Environment Variables for Tracking Service
# File: /etc/homeease/tracking.env
# Permissions: chmod 600 /etc/homeease/tracking.env
#              chown homeease:homeease /etc/homeease/tracking.env
#
# ⚠️  DO NOT COMMIT THIS FILE TO SOURCE CONTROL.
# ==============================================================================

# Redis (co-located on same EC2 for Phase 1)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# JWT signing secret (must match the main backend service)
JWT_SECRET=REPLACE_WITH_JWT_SECRET_MIN_32_CHARS

# Google Maps API Key (enable Routes API and Directions API in GCP console)
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY

# Kafka (keep false for Phase 1; set true when scaling to 10,000+ sessions)
TRACKING_KAFKA_ENABLED=false

# Optional tuning overrides (defaults are production-safe)
# TRACKING_RATE_LIMIT_MAX=30
# TRACKING_MAX_ACCURACY_METERS=50.0
# TRACKING_MOVEMENT_THRESHOLD=15.0
