        {
          "name": "Verify Worker KYC",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workers/{{workerId}}/verify-kyc",
              "host": ["{{baseUrl}}"],
              "path": ["workers", "{{workerId}}", "verify-kyc"]
            }
          }
        },
        {
          "name": "Block Worker Partner",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workers/{{workerId}}/block?hours=24",
              "host": ["{{baseUrl}}"],
              "path": ["workers", "{{workerId}}", "block"],
              "query": [
                {
                  "key": "hours",
                  "value": "24",
                  "description": "Duration in hours to block"
                }
              ]
            }
          }
        },
        {
          "name": "Unblock Worker Partner",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workers/{{workerId}}/unblock",
              "host": ["{{baseUrl}}"],
              "path": ["workers", "{{workerId}}", "unblock"]
            }
          }
        }
