{
  "info": {
    "_postman_id": "homeease-admin-apis-only",
    "name": "HomeEase Admin APIs (No JWT)",
    "description": "Comprehensive Postman collection containing ONLY the Admin APIs for HomeEase Backend. Fully ready for local testing with MySQL and no JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1/admin"
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "subServiceId",
      "value": ""
    },
    {
      "key": "bannerId",
      "value": ""
    },
    {
      "key": "couponId",
      "value": ""
    },
    {
      "key": "workerId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Admin Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@homeease.com\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/admin/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "admin", "auth", "login"]
            }
          }
        }
      ]
    },
    {
